{
  "name": "filebeat-index-rejects",
  "type": "monitor",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 5,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "wazuh-alerts-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "rule.id": "100350"
                  }
                },
                {
                  "range": {
                    "timestamp": {
                      "gte": "now-10m"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "query_level_trigger": {
        "name": "Filebeat Rejected Events",
        "severity": "2",
        "condition": {
          "script": {
            "source": "ctx.results[0].hits.total.value > 0",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "telegram notify",
            "destination_id": "<NOTIFICATION_CHANNEL_ID>",
            "message_template": {
              "source": "{\n  \"chat_id\": \"<CHAT_ID>\",\n \"text\": \"Wazuh Monitor {{ctx.monitor.name}} is in ALERT status.\\nTrigger: {{ctx.trigger.name}}\\nSeverity: {{ctx.trigger.severity}}\\nPeriod end: {{ctx.periodEnd}}\\nFilebeat reported that the indexer rejected one or more events in the last 10 minutes (rule 100350). See /var/log/filebeat/filebeat and the full_log of the 100350 alert on the Wazuh manager.\"\n}",
              "lang": "mustache"
            },
            "throttle_enabled": true,
            "subject_template": {
              "source": "Alerting Notification action",
              "lang": "mustache"
            },
            "throttle": {
              "value": 60,
              "unit": "MINUTES"
            }
          }
        ]
      }
    }
  ]
}
